# ============================================================
# ProTemp Studio - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ProTemp Studio

# ------------------------------------------------------------
# Database (PostgreSQL via Prisma / Supabase)
# ------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/protemp?schema=public

# ------------------------------------------------------------
# Authentication (NextAuth.js or Supabase Auth)
# ------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth Provider
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------
# Supabase (if using Supabase instead of raw Prisma)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------
# File Storage (e.g. Supabase Storage / AWS S3)
# ------------------------------------------------------------
NEXT_PUBLIC_STORAGE_BUCKET=portfolio-assets
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ------------------------------------------------------------
# Email (e.g. Resend / SendGrid for contact form submissions)
# ------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@protemp.studio

# ------------------------------------------------------------
# Analytics (optional)
# ------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
